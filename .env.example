# Copy to .env (Docker Compose) or .env.local (npm run dev).
# Do not commit secrets.

# Optional: CARTO Basemaps API key for /api/basemap (light_nolabels).
# Unset → unauthenticated CARTO fallback still works.
CARTO_API_KEY=

# Host port mapping for docker compose (container always listens on 43127).
PORT=43127
